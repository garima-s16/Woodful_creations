{
  "name": "woodful-creations",
  "version": "1.0.0",
  "description": "Woodful Creations - stock inventory, estimates, attendance, interviews, and client management",
  "private": true,
  "scripts": {
    "install-all": "npm install && cd frontend && npm install && cd ..",
    "backend": "cd backend && python main.py",
    "frontend": "cd frontend && npm start",
    "dev": "concurrently \"npm run backend\" \"npm run frontend\"",
    "start": "concurrently \"npm run backend\" \"npm run frontend\"",
    "build": "cd frontend && npm run build",
    "test": "cd frontend && npm test"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  },
  "keywords": ["woodful", "stock-management", "inventory", "client-management", "estimates", "attendance", "interviews"],
  "author": "Woodful Creations",
  "license": "PROPRIETARY"
}
