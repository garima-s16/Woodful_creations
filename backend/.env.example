DATABASE_URL=******localhost:5432/woodful_creations
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
DEBUG=False
SECRET_KEY=replace-with-a-random-secret-key-at-least-32-characters
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=your_email@gmail.com
SENDER_PASSWORD=your_app_password
SENDER_NAME=Woodful Creations
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
APP_NAME=Woodful Creations
APP_VERSION=2.0.0
OPENAI_API_KEY=
REDIS_URL=redis://localhost:6379
ENVIRONMENT=production

# CORS: comma-separated list of allowed origins for web and mobile clients.
# For mobile (iPhone), include the server IP/hostname the device will connect to.
# Example: ALLOWED_ORIGINS=https://app.woodfulcreations.com,http://192.168.1.10:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Master user credentials — used only by scripts/init_db.py to seed the first admin account.
# These are NOT used at runtime. Change the password immediately after initial setup.
MASTER_USER_EMAIL=admin@woodfulcreations.com
MASTER_USER_USERNAME=admin
MASTER_USER_FULL_NAME=Administrator
MASTER_USER_PASSWORD=set-a-strong-password-here
