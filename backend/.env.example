# Copy this file to .env and fill in real values. Never commit .env.

ENVIRONMENT=development
# Never set DEBUG=True with ENVIRONMENT=production - it exposes full stack
# tracebacks (file paths, code, potentially secrets) in HTTP error responses.
# This is enforced by a startup validator, not just this comment.
DEBUG=True

DATABASE_URL=sqlite:///./woodful.db

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
COOKIE_SECURE=False
COOKIE_SAMESITE=lax

# Comma-separated list, no spaces, no wildcard in production
CORS_ORIGINS=http://localhost:3000

# Must match what app/modules/communications/services.py actually reads.
# SENDER_EMAIL / SENDER_PASSWORD are both required together - leaving either blank
# disables email sending entirely (payment receipts, invoices, task notifications, etc.
# fail with a clear "not configured" message rather than a silent no-op).
#
# CENTRAL WOODFUL SENDER IDENTITY: all business emails (invoices, payment receipts,
# estimates, task/team notifications) are sent from this single system account, never
# from an individual user's own address - no API endpoint accepts a "from" field from
# the frontend, so this value is the sole, backend-controlled source of truth for every
# outgoing email. The intended production value is:
#   SENDER_EMAIL=woodfulcreationss@gmail.com
#   SENDER_NAME=Woodful Creations
#
# GMAIL SPECIFICALLY: if the sending account has 2-Step Verification enabled (Google's
# default for most accounts today), the normal account password will NOT work here and
# SMTP login will fail with an authentication error. Generate a 16-character Gmail
# "App Password" instead (Google Account -> Security -> 2-Step Verification ->
# App Passwords) and use that as SENDER_PASSWORD. If 2-Step Verification is off, the
# regular account password may work, but Google is phasing this out - an App Password
# is the reliable, current approach.
#
# WHY SMTP + APP PASSWORD RATHER THAN THE GMAIL API/OAUTH2: OAuth2 with a gmail.send
# scope is Google's more modern, narrower-permission option, and is the right direction
# for a future iteration. It requires infrastructure this codebase does not yet have -
# a Google Cloud project, an OAuth consent screen, a client ID/secret pair, a one-time
# interactive browser authorization to obtain a refresh token, and a token-refresh
# storage/rotation path (the google-auth/google-api-python-client libraries are not
# currently a dependency here either). None of that can be safely stood up or verified
# without real Google Cloud access and a live browser authorization step, so it is not
# implemented as part of this change - doing so blind, with no way to test the OAuth
# flow end-to-end, would risk replacing a working send path with a broken one. SMTP
# with an App Password is Google's own supported alternative for exactly this situation
# (a script/service sending mail without the full OAuth app-review process) and keeps
# the credential entirely backend-only, matching the security requirement even though
# it is not the narrowest possible Gmail permission model.
SENDER_EMAIL=
SENDER_PASSWORD=
SENDER_NAME=Woodful Creations
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Used to build links sent in emails (e.g. password reset links).
FRONTEND_URL=http://localhost:3000

# Woodful AI Gateway (Gemini) - server-side only, never exposed to the
# frontend. GEMINI_ENABLED is an explicit opt-in: setting only the API
# key does not silently turn this on, and setting GEMINI_ENABLED=True
# without a real GEMINI_API_KEY is rejected at startup rather than
# failing confusingly on the first chat message. When disabled (the
# default), the Woodful Assistant still works using its existing
# rule-based/keyword matching - Gemini is a fallback for messages that
# don't match, not a requirement for the assistant to function at all.
GEMINI_ENABLED=False
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# A bounded wait for a single Gemini call, comfortably under typical
# HTTP/proxy timeouts, so a slow provider response can't itself cause
# a confusing gateway-timeout error.
GEMINI_TIMEOUT_SECONDS=15

# Google Drive document storage - also an explicit opt-in, matching
# GEMINI_ENABLED's pattern. When disabled (the default), uploaded
# documents/attachments are stored locally instead (see
# STORAGE_PROVIDER/STORAGE_LOCAL_ROOT). Setting STORAGE_PROVIDER=drive
# without GOOGLE_DRIVE_ENABLED=True is rejected at startup.
GOOGLE_DRIVE_ENABLED=False
GOOGLE_DRIVE_CREDENTIALS_PATH=
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Rate limiting - see app/platform/security.py.
# "memory" (default) works for a single-process deployment with zero
# extra infrastructure. A multi-instance/multi-worker production
# deployment MUST use "redis" instead, or each instance's rate limits
# will be tracked independently and the effective limit will be
# (configured limit) x (number of instances).
RATE_LIMIT_BACKEND=memory
# Required only when RATE_LIMIT_BACKEND=redis.
REDIS_URL=redis://localhost:6379/0

# Auto-generates notifications (delivery risk, material shortage,
# procurement, production blockers, payment, approvals, payroll,
# overdue tasks) on a background timer instead of only when someone
# opens the notification panel. Single-process only (matches this
# app's single uvicorn worker, no --workers) - disable if you run a
# multi-instance deployment with an external scheduler already calling
# POST /api/automation/run instead.
AUTOMATION_SCHEDULER_ENABLED=true
AUTOMATION_SCHEDULER_INTERVAL_MINUTES=15

# The reverse proxy/load balancer's IP or CIDR in front of this app -
# required in production so per-IP rate limiting sees the real client IP
# instead of the proxy's own IP. Leave as the default for local dev with
# no proxy in front.
FORWARDED_ALLOW_IPS=127.0.0.1

# Production error/monitoring boundary - see app/platform/monitoring.py.
# "none" (default) logs unhandled exceptions locally only. "sentry" also
# sends them to a configured Sentry project - requires MONITORING_DSN and
# the optional sentry-sdk package (see requirements.txt).
MONITORING_PROVIDER=none
MONITORING_DSN=
