# ==========================================
# Woodful Stock Inventory - Backend Configuration
# Copy this file to .env and update the values with your configuration
# DO NOT commit .env file to version control
# ==========================================

# ==========================================
# Database Configuration
# ==========================================
# SQLite (default for development)
DATABASE_URL=sqlite:///./stock_inventory.db

# PostgreSQL (for production)
# DATABASE_URL=postgresql://username:password@localhost:5432/woodful_inventory
# DATABASE_POOL_SIZE=20
# DATABASE_MAX_OVERFLOW=10

# ==========================================
# Security Configuration
# ==========================================
# Generate a secure secret key using: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-change-this-in-production-use-32-chars-minimum
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ==========================================
# Environment Configuration
# ==========================================
DEBUG=False
ENVIRONMENT=development
# Options: development, staging, production

# ==========================================
# AI/LLM Configuration
# ==========================================
# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview
# Options: gpt-4, gpt-4-turbo-preview, gpt-3.5-turbo

# LangChain Configuration
LANGCHAIN_API_KEY=your-langchain-api-key-here
LANGCHAIN_PROJECT=woodful-inventory
LANGCHAIN_TRACING_V2=false

# ==========================================
# Server Configuration
# ==========================================
HOST=0.0.0.0
PORT=8000
RELOAD=true
# For production, set RELOAD=false and use gunicorn

# ==========================================
# CORS Configuration
# ==========================================
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000

# ==========================================
# Email Configuration (Optional)
# ==========================================
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SENDER_EMAIL=noreply@woodful.com
SMTP_USE_TLS=true

# ==========================================
# Logging Configuration
# ==========================================
LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT=json
# Options: json, text

# ==========================================
# Stock Inventory Settings
# ==========================================
MAX_REORDER_LEVEL=1000
MIN_STOCK_ALERT_THRESHOLD=10
FORECAST_DAYS=30
AUTO_REORDER_ENABLED=false

# ==========================================
# JWT Configuration
# ==========================================
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=7

# ==========================================
# AWS Configuration (if using S3 for file storage)
# ==========================================
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_REGION=us-east-1
# AWS_S3_BUCKET_NAME=woodful-inventory-bucket

# ==========================================
# Redis Configuration (if using caching)
# ==========================================
# REDIS_URL=redis://localhost:6379/0
# REDIS_CACHE_ENABLED=false

# ==========================================
# API Rate Limiting
# ==========================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=3600
# Requests per PERIOD (in seconds)

# ==========================================
# File Upload Configuration
# ==========================================
MAX_UPLOAD_SIZE=10485760
# Max file size in bytes (10MB default)
ALLOWED_FILE_TYPES=.csv,.xlsx,.json
UPLOAD_DIRECTORY=./uploads

# ==========================================
# Notification Settings
# ==========================================
SEND_LOW_STOCK_ALERTS=true
SEND_REORDER_NOTIFICATIONS=true
ALERT_EMAIL_RECIPIENTS=admin@example.com

# ==========================================
# Analytics Configuration (Optional)
# ==========================================
# GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X
# SENTRY_DSN=https://key@sentry.io/project-id

# ==========================================
# Feature Flags (Optional)
# ==========================================
ENABLE_AI_FORECASTING=true
ENABLE_AUTOMATED_ORDERING=false
ENABLE_ADVANCED_ANALYTICS=true
