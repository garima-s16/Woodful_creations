# DATABASE
DATABASE_URL=postgresql://user:password@localhost:5432/woodful_creations

# JWT
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# EMAIL
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-16-char-app-password
BUSINESS_OWNER_EMAIL=owner@example.com
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# OPENAI
OPENAI_API_KEY=sk-your-api-key-here

# APP
APP_NAME=Woodful Creations
APP_VERSION=2.0.0
ENVIRONMENT=development
DEBUG=True

# CORS
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:3001","http://127.0.0.1:3000"]

# FILE STORAGE
MAX_UPLOAD_SIZE=52428800
UPLOAD_DIRECTORY=./uploads
ALLOWED_EXTENSIONS=["pdf","xlsx","docx","jpg","png","jpeg"]

# REDIS
REDIS_URL=redis://localhost:6379

# AWS (Optional for production)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# SENDGRID (Optional)
SENDGRID_API_KEY=

# LOGGING
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
