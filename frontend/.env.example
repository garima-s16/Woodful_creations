REACT_APP_API_URL=http://127.0.0.1:8000
REACT_APP_APP_NAME=Woodful Creations
REACT_APP_ENVIRONMENT=development

# Speeds up react-scripts' dev-server compile time meaningfully (a
# well-documented Create React App / webpack lever) - source maps are
# genuinely not needed for normal day-to-day development, only when
# actively debugging a minified stack trace. Uncomment if startup
# still feels slow after the API_URL fix above:
# GENERATE_SOURCEMAP=false
