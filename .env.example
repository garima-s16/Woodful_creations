# Copy this file to .env (same directory as docker-compose.yml) and
# fill in real values. Never commit .env.
#
# Used by docker-compose.yml. Generate strong random values with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

POSTGRES_PASSWORD=
SECRET_KEY=
REDIS_PASSWORD=

# Optional overrides (defaults shown in docker-compose.yml)
# CORS_ORIGINS=http://localhost:3000
# REACT_APP_API_URL=http://localhost:8000

# Family 105 - storage provider (see backend/app/storage/). Defaults
# to "local" and needs no configuration to keep working exactly as
# before - no existing route reads these yet.
# STORAGE_PROVIDER=local
# STORAGE_LOCAL_ROOT=./storage_data
# GOOGLE_DRIVE_CREDENTIALS_PATH=
# GOOGLE_DRIVE_ROOT_FOLDER_ID=
