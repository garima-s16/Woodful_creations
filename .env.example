# ==========================================
# Woodful Stock Inventory - Frontend Configuration
# Copy this file to .env.local and update the values
# ==========================================

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000

# Application Settings
NEXT_PUBLIC_APP_NAME=Woodful Stock Inventory
NEXT_PUBLIC_APP_DESCRIPTION=AI-powered stock inventory management system

# Feature Flags
NEXT_PUBLIC_ENABLE_DARK_MODE=true
NEXT_PUBLIC_ENABLE_NOTIFICATIONS=true

# Optional: Analytics
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X
